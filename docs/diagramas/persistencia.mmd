erDiagram
  pie_sessions ||--o{ pie_events : "árbol (parent_id)"
  pie_sessions ||--o{ pie_cursors : "reacciones"
  pie_events {
    text id PK "determinista"
    text session_id
    text parent_id
    int seq
    text type "núcleo o plugin/evento"
    json data
  }
  pie_sessions {
    text id PK
    text cwd
    text model
    text leaf_id "cabeza de la rama"
  }
  pie_config {
    int seq PK
    text type "plugin/installed|removed|disabled|enabled"
    json data "con el código fuente"
  }
  pie_cursors {
    text reaction_id PK
    text session_id PK
    int seq
  }
  pie_workflow {
    text id PK
    text kind "execution|activity|deferred|clock|result"
    json data
  }
  pie_lock {
    text name PK
    text owner
    int expires_at
  }
