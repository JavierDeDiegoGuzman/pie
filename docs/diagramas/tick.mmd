flowchart TB
  start["arranque del proceso<br/>(todos los runs abiertos)"] --> fold
  ext["API: prompt · steer · abort"] --> append
  subgraph TICK["tick(sesión)"]
    fold["plegar la rama: evolve"] --> decide["decide(estado, ahora)"]
  end
  decide --> cmdModel["CallModel<br/>model/requested → responded | failed"]
  decide --> tool["RunTool<br/>tool/started → finished"]
  decide --> deliver["Deliver<br/>user (steer / followUp)"]
  decide --> end_["EndRun<br/>run/ended"]
  decide --> wake["WakeAt<br/>despertador (backoff)"]
  cmdModel & tool & deliver & end_ --> append["añadir evento al log<br/>id determinista · idempotente"]
  append -- despierta --> fold
  append -- despierta --> react["reacciones de plugins<br/>cursor durable"]
  wake -- a su hora --> fold
