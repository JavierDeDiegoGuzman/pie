flowchart TB
  host["Tu código / futura UI / CLI"]
  sup["Supervisor<br/>relanza al salir con 75"]
  subgraph CORE["Núcleo fijo"]
    api["Pie · Session<br/>prompt · steer · followUp · abort · navigate · events · live"]
    rt["Runtime: tick<br/>plegar → decide → ejecutar → eventos"]
    agent["Agent<br/>evolve · decide · vista (puros)"]
    log[("Log de sesión<br/>árbol de eventos")]
    cfg[("Log de configuración<br/>plugins instalados")]
    mgr["Plugins<br/>validar · hot / restart · protegidos"]
    reg["Registries (State)<br/>tools · modelos · prompt · hooks · eventos · proyecciones · reacciones"]
    host2["PluginHost<br/>cada plugin en su Scope"]
    wf["LogWorkflowEngine<br/>workflows de Effect sobre la BD"]
  end
  subgraph PLUGINS["Plugins (el agente puede escribirlos)"]
    p1["opencode-go"]
    p2["coding-tools"]
    p3["system-prompt · context-files"]
    p4["self (protegido)"]
    p5["todo · los del agente"]
  end
  host --> api --> rt
  sup -. ejecuta .-> host
  rt --> agent
  rt <--> log
  mgr --> cfg
  mgr --> host2 --> reg
  rt --> reg
  p1 & p2 & p3 & p4 & p5 --> host2
  p4 -. plugin_install .-> mgr
  wf --> log
