---
// The title of every docs page: a kicker with the section, the title, and the
// page's description as a lede, over the warm glow of the landing page.

const { entry, id } = Astro.locals.starlightRoute
const section = id.startsWith("docs/")
  ? id === "docs/references" ? "Project" : "Docs"
  : id === "changelog" ? "Project" : "Start here"
---

<div class="pie-title">
  <p class="pie-kicker">{section}</p>
  <h1 id="_top">{entry.data.title}</h1>
  {entry.data.description && <p class="pie-lede">{entry.data.description}</p>}
  <div class="pie-rule" aria-hidden="true"></div>
</div>

<style>
  .pie-title { position: relative; padding: 0.5rem 0 0.25rem; }
  .pie-title::before {
    content: "";
    position: absolute;
    inset: -3rem -4rem auto -2rem;
    height: 15rem;
    background: radial-gradient(60% 70% at 15% 30%, rgb(244 196 110 / 0.22), transparent 70%),
      radial-gradient(40% 60% at 70% 10%, rgb(196 47 74 / 0.10), transparent 70%);
    pointer-events: none;
    z-index: -1;
  }
  .pie-kicker {
    margin: 0.5rem 0 0.6rem;
    font: 600 0.75rem var(--sl-font-mono);
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--sl-color-accent);
  }
  h1 {
    margin: 0;
    font-family: var(--pie-serif);
    font-size: clamp(2.3rem, 4.5vw, 3.3rem);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.025em;
    color: var(--sl-color-white);
  }
  .pie-lede {
    margin: 0.9rem 0 0;
    max-width: 38em;
    font-size: 1.15rem;
    line-height: 1.55;
    color: var(--sl-color-gray-2);
  }
  .pie-rule {
    width: 3.5rem;
    height: 4px;
    margin-top: 1.4rem;
    border-radius: 4px;
    background: linear-gradient(90deg, #c42f4a, #e9a848);
  }
</style>
