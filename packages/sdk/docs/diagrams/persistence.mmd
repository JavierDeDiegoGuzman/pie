erDiagram
  pie_sessions ||--o{ pie_events : "tree (parent_id)"
  pie_sessions ||--o{ pie_cursors : "reactions"
  pie_events {
    text id PK "deterministic"
    text session_id
    text parent_id
    int seq
    text type "core or plugin/event"
    json data
  }
  pie_sessions {
    text id PK
    text cwd
    text model
    text leaf_id "head of the branch"
  }
  pie_config {
    int seq PK
    text type "plugins/snapshot|config/good"
    json data "the whole plugins folder"
  }
  pie_cursors {
    text reaction_id PK
    text session_id PK
    int seq
  }
  pie_workflow {
    text id PK
    text kind "execution|activity|deferred|clock|result"
    json data
  }
  pie_lock {
    text name PK
    text owner
    int expires_at
  }
