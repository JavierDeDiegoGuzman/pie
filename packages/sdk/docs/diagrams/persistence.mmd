erDiagram
  pie_sessions ||--o{ pie_events : "tree (parent_id)"
  pie_sessions ||--o{ pie_cursors : "reactions"
  pie_events {
    text id PK "deterministic"
    text session_id
    text parent_id
    int seq
    text type "core or plugin/event"
    json data
  }
  pie_sessions {
    text id PK
    text cwd
    text model
    text leaf_id "head of the branch"
  }
  pie_cursors {
    text reaction_id PK
    text session_id PK
    int seq
  }
  pie_workflow {
    text id PK
    text kind "execution|activity|deferred|clock|result"
    json data
  }
  pie_attachments {
    text hash PK "sha256 of the bytes"
    text media_type
    int size
    text file "in attachments/ next to the db"
  }
  pie_meta {
    text key PK "opened_by"
    text value "pid of the owner"
  }
