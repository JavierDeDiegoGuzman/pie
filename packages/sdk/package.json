{
  "name": "pie-agent",
  "version": "0.1.0",
  "description": "A durable, self-modifying coding agent on Effect: pi's minimal core, an event log you can replay, and every feature as an editable plugin.",
  "license": "MIT",
  "author": "Javier de Diego Guzmán",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JavierDeDiegoGuzman/pie.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/JavierDeDiegoGuzman/pie#readme",
  "bugs": {
    "url": "https://github.com/JavierDeDiegoGuzman/pie/issues"
  },
  "keywords": [
    "agent",
    "coding-agent",
    "llm",
    "effect",
    "durable",
    "event-sourcing",
    "self-modifying",
    "pi"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "exports": {
    ".": {
      "pie-source": "./src/index.ts",
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "pie": "./dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "plugins",
    "docs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "prepack": "node scripts/prepack.mjs"
  },
  "dependencies": {
    "@effect/ai-openai-compat": "4.1.2",
    "@effect/platform-node": "4.1.2",
    "@effect/sql-sqlite-node": "4.1.2",
    "effect": "4.1.2",
    "htm": "^3.1.1",
    "preact": "^11.1.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
