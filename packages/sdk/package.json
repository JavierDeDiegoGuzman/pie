{
  "name": "pie-agent",
  "version": "0.1.0",
  "description": "Pie's SDK: a durable agent runtime on Effect. An event log you can replay, pi's minimal core, and every feature a plugin.",
  "license": "MIT",
  "author": "Javier de Diego Guzmán",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JavierDeDiegoGuzman/pie.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://javierdediegoguzman.github.io/pie/",
  "bugs": {
    "url": "https://github.com/JavierDeDiegoGuzman/pie/issues"
  },
  "keywords": [
    "agent",
    "coding-agent",
    "llm",
    "effect",
    "durable",
    "event-sourcing",
    "self-modifying",
    "pi"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "exports": {
    ".": {
      "pie-source": "./src/index.ts",
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/src",
    "docs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "prepack": "node ../../scripts/prepack.mjs sdk"
  },
  "dependencies": {
    "@effect/platform-node": "4.1.2",
    "@effect/sql-sqlite-node": "4.1.2",
    "effect": "4.1.2"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
